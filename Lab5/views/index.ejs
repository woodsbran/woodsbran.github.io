<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab 5 - Quote Finder</title>

    <!-- I'm using Bootstrap so I can use the modal and cleaner styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- This is my own css file -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="container py-4">
        <h1 class="text-center mb-4">Famous Quote Finder</h1>

        <!-- This is my search form -->
        <form method="GET" action="/" class="search-form">
            <div class="mb-3">
                <label for="keyword" class="form-label">Keyword:</label>
                <input
                    type="text"
                    id="keyword"
                    name="keyword"
                    class="form-control"
                    value="<%= keyword %>"
                    placeholder="Search quote text"
                >
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category:</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All Categories</option>
                    <% categories.forEach(c => { %>
                        <option value="<%= c.category %>" <%= category === c.category ? "selected" : "" %>>
                            <%= c.category %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="author" class="form-label">Author Name:</label>
                <input
                    type="text"
                    id="author"
                    name="author"
                    class="form-control"
                    list="authorList"
                    value="<%= author %>"
                    placeholder="Type an author's name"
                >

                <datalist id="authorList">
                    <% authors.forEach(a => { %>
                        <option value="<%= a.fullName %>"></option>
                    <% }) %>
                </datalist>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="minLikes" class="form-label">Min Likes:</label>
                    <input
                        type="number"
                        id="minLikes"
                        name="minLikes"
                        class="form-control"
                        value="<%= minLikes %>"
                    >
                </div>

                <div class="col-md-6 mb-3">
                    <label for="maxLikes" class="form-label">Max Likes:</label>
                    <input
                        type="number"
                        id="maxLikes"
                        name="maxLikes"
                        class="form-control"
                        value="<%= maxLikes %>"
                    >
                </div>
            </div>

            <div class="button-row">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/" class="btn btn-secondary">Clear</a>
            </div>
        </form>

        <h2 class="mb-3">Results</h2>

        <% if (quotes.length === 0) { %>
            <div class="alert alert-light border">
                No quotes found.
            </div>
        <% } else { %>
            <% quotes.forEach(q => { %>
                <div class="quote-box">
                    <p class="quote-text">"<%= q.quote %>"</p>

                    <p>
                        <strong>Author:</strong>
                        <button
                            type="button"
                            class="author-link btn btn-link p-0"
                            data-authorid="<%= q.authorId %>"
                            data-bs-toggle="modal"
                            data-bs-target="#authorModal"
                        >
                            <%= q.fullName %>
                        </button>
                    </p>

                    <p><strong>Category:</strong> <%= q.category %></p>
                    <p><strong>Likes:</strong> <%= q.likes %></p>
                </div>
            <% }) %>
        <% } %>
    </div>

    <!-- This is my Bootstrap modal -->
    <div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="authorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="authorModalLabel">Author Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="authorInfo">
                    <p>Loading author information...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- My own JS -->
    <script src="/js/script.js"></script>
</body>
</html>