<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="mb-0">Authors</h1>
  <a href="/authors/new" class="btn btn-primary">Add New Author</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Name</th>
            <th>Profession</th>
            <th>Country</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% authors.forEach(author => { %>
            <tr>
              <td><%= author.firstName %> <%= author.lastName %></td>
              <td><%= author.profession %></td>
              <td><%= author.country %></td>
              <td>
                <a href="/authors/edit/<%= author.authorId %>" class="btn btn-warning btn-sm">Edit</a>
                <a href="/authors/delete/<%= author.authorId %>" 
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete this author?')">
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("partials/footer") %>