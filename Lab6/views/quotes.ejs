<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="mb-0">Quotes</h1>
  <a href="/quotes/new" class="btn btn-success">Add New Quote</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Quote</th>
            <th>Author</th>
            <th>Category</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% quotes.forEach(item => { %>
            <tr>
              <td>"<%= item.quote %>"</td>
              <td><%= item.firstName %> <%= item.lastName %></td>
              <td><%= item.category %></td>
              <td>
                <a href="/quotes/edit/<%= item.quoteId %>" class="btn btn-warning btn-sm">Edit</a>
                <a href="/quotes/delete/<%= item.quoteId %>" 
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete this quote?')">
                  Delete
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("partials/footer") %>